{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "draft-ice",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DRAFT_ROOMS",
        "class_name": "DraftRoom"
      }
    ]
  },
  "exports": {
    "DraftRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
